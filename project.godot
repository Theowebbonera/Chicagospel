; Chicago – svensk pokervariant med stick, i 3D. Allt byggs i kod (scripts/main.gd).

config_version=5

[application]

config/name="Chicago"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

general/default_playback_type.web=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.web=0
anti_aliasing/quality/msaa_2d=2
anti_aliasing/quality/msaa_2d.web=0
viewport/hdr_2d=false
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
